@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="container py-5">
    <div class="row align-items-center">
        <div class="col-md-6">
            <span class="badge bg-warning text-dark mb-3">Beauty and Wellness Recruitment</span>
            <h1 class="display-4">Build Your Career in Beauty and Wellness</h1>
            <p class="lead">AuraBridge Talent Group connects qualified beauty and wellness
                professional with reputable salons, spas, and wellness businesses </p>
                <a class="btn btn-dark" href="#apply">View Application Process</a>
            </div>
            <div class="col-md-6">
                <img src="~/images/salon-team.png" class="img-fluid rounded shadow" alt="Beauty and 
                Wellness professionals working together" />
            </div>
        </div>
    </div>

    <section class="bg-light py-5">
        <div class="container">
            <h2 class="text-center mb-4">Our Recruiting Services</h2>

            <div class="row g-4">
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h3 class="h5 card-title">Professional Job Placement</h3>
                            <p class="cardtext">We connect qualified beauty and wellness
                                professionals with full-time, part-time, and contract opportunities.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h3 class="h5 card-title">Employer Recruitment</h3>
                            <p class="card-text">We help salons, spas, and wellness businesses find
                                dependable professionals who meet their hiring needs.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h3 class="h5 card-title">Career Support</h3>
                            <p class="card-text">Candidates receive resume guidance, portfolio support,
                                and interview preparation from our recruiting team.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <section class="container py-5">
            <div class="row align-items-center">
                <div class="col-md-5">
                    <h2>Industries We Specialize In</h2>
                    <p>Our recruiters understand the qualifications and professional skills needed throughout the beauty and
                        wellness industry.</p>
                    </div>

                    <div class="col-md-7">
                        <ul class="list-group shadow-sm">
                            <li class="list-group-item">Unisex hair salons and barbershops</li>
                            <li class="list-group-item">Day spas and wellness centers</li>
                            <li class="list-group-item">Medical spas and skincare studios</li>
                            <li class="list-group-item">Hotel and resort spas</li>
                            <li class="list-group-item">Nail, brow, and lash studios</li>
                        </ul>
                    </div>
                </div>
            </section>
            <section class="bg-light py-5">
                <div class="container">
                    <h2 class="text-center mb-4">What Our Clients Say</h2>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-body">
                                    <p class="card-text">“AuraBridge helped me find a salon that matched my
                                        schedule and professional goals. My recruiter supported me throughout the interview
                                        process.”
                                    </p>
                                    <p class="fw-bold mb-0">Sofia M.</p>
                                    <p class="text-muted mb-0">Hairstylist</p>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-body">
                                    <p class="card-text">“The AuraBridge team understood our hiring needs and introduced us to
                                        qualified, prepared, and dependable candidates.”
                                    </p>
                                    <p class="fw-bold mb-0">Natalie R.</p>
                                    <p class="text-muted mb-0">Spa Director</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            <section id="apply" class="bg-dark text-white py-5">
                <div class="container">
                    <h2 class="text-center">How to Apply</h2>
                    <p class="text-center lead mb-4">Complete our online process and begin your beauty and wellness career search.
                    </p>

                    <div class="row g-4 text-dark">
                        <div class="col-md-4">
                            <div class="card h-100 text-center">
                                <div class="card-body">
                                    <span class="badge bg-warning text-dark mb-3">Step 1</span>
                                    <h3 class="h5">Create Your Profile</h3>
                                    <p>Enter your contact information, experience, education, and career interests.</p>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="card h-100 text-center">
                                <div class="card-body">
                                    <span class="badge bg-warning text-dark mb-3">Step 2</span>
                                    <h3 class="h5">Upload Your Documents</h3>
                                    <p>Upload your résumé, professional licenses, certifications, and portfolio.</p>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="card h-100 text-center">
                                <div class="card-body">
                                    <span class="badge bg-warning text-dark mb-3">Step 3</span>
                                    <h3 class="h5">Meet Your Recruiter</h3>
                                    <p>A recruiter will review your profile and contact you about suitable opportunities.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-warning text-dark text-center mt-4 mb-0">
                        Applications are reviewed within two business days. Start your profile today!
                    </div>
                </div>
            </section>
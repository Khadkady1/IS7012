@page

@{
    ViewData["Title"] = "Our Team";
}

<div class="container py-5">
    <div class="row align-items-center mb-5">
        <div class="col-md-6">
            <span class="badge bg-warning text-dark mb-3">Meet the People Behind AuraBridge</span>
            <h1 class="display-5">Our Team</h1>
            <p class="lead">Our team helps beauty and wellness professionals find workplaces where
                they can learn, contribute, and build successful careers.
            </p>
        </div>

        <div class="col-md-6">
            <img src="~/images/salon-team.png" class="img-fluid rounded shadow" alt="Beauty and 
            Wellness professionals working together" />
        </div>
    </div>
</div>
<section class="container pb-5">
    <h2 class="text-center mb-4">Our Recruiting Professionals</h2>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3 class="h4 card-title">Dikshya Khadka</h3>
                    <p class="text-muted">Client and Operations Coordinator</p>
                    <p class="card-text">Dikshya supports client communication and recruiting operations. Her background
                        in Information Systems and Business Analytics helps her organize candidate information and
                        improve business processes.</p>
                        <span class="badge bg-secondary">Operations</span>
                        <span class="badge bg-secondary">Business Analysis</span>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h3 class="h4 card-title">Maya Patel</h3>
                        <p class="text-muted">Senior Beauty and Wellness Recruiter</p>
                        <p class="card-text">Maya works with salons, spas, and wellness businesses to understand their
                            hiring needs and identify qualified professionals.</p>
                            <span class="badge bg-secondary">Recruiting</span>
                            <span class="badge bg-secondary">Client Relations</span>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h3 class="h4 card-title">Jordan Lee</h3>
                            <p class="text-muted">Career Development Specialist</p>
                            <p class="card-text">Jordan helps candidates prepare résumés, organize professional portfolios, and
                                practice for employment interviews.</p>
                                <span class="badge bg-secondary">Career Coaching</span>
                                <span class="badge bg-secondary">Interview Preparation</span>
                            </div>
                        </div>
                    </div>
                </div>
            </section>